rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // القراءة عامة — الموقع يعرض المحتوى للزوار
    match /settings/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /projects/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /skills/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /features/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // رسائل الزوار: أي شخص يقدر يرسل، القراءة والحذف للمسجلين فقط
    match /messages/{doc} {
      allow read, delete: if request.auth != null;
      allow create: if true;
      allow update: if false;
    }
  }
}
